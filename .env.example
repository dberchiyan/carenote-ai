# Copy to .env and fill in. Never commit .env. Synthetic data only.

# dev (default) | test | prod. prod refuses the default session secret and marks cookies Secure.
CARENOTE_ENV=dev
CARENOTE_LOG_LEVEL=INFO

# Provider selection. Transcription: "local" (default: Whisper on this machine, no key, audio
# never leaves the host) · "openai" · "fake" (tests only; ignores the audio).
# Extraction: "fake" (rule-based, keyless) · "anthropic" · "openai".
CARENOTE_TRANSCRIPTION_PROVIDER=local
CARENOTE_LLM_PROVIDER=fake

# API keys for real providers (only needed when not using "fake").
CARENOTE_OPENAI_API_KEY=
CARENOTE_ANTHROPIC_API_KEY=
# Models (defaults shown).
CARENOTE_ANTHROPIC_MODEL=claude-opus-5-5
CARENOTE_OPENAI_MODEL=gpt-5-mini
CARENOTE_OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Session cookie signing key (required when CARENOTE_ENV=prod).
CARENOTE_SESSION_SECRET=

# PostgreSQL is external (not part of docker compose). Locally it is reached over an SSH tunnel
# (`make db-tunnel` -> 127.0.0.1:5433); containers use host.docker.internal.
CARENOTE_DB_HOST=host.docker.internal
CARENOTE_DB_PORT=5433
# Owner role (migrations) and restricted runtime role passwords.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# Backend tests create a throwaway carenote_test database through this admin connection.
CARENOTE_TEST_ADMIN_URL=postgresql+psycopg://carenote:<POSTGRES_PASSWORD>@127.0.0.1:5433/postgres
